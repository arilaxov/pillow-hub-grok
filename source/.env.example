# Pillow Hub works without any environment configuration.
PORT=8765
HOST=127.0.0.1

# Optional Telegram bot. Use your existing .env or set the token here.
BOT_TOKEN=
BOT_USERNAME=pillow_hub_bot
# Public HTTPS address, only needed for Telegram Mini App links.
PUBLIC_URL=

# Optional feedback forwarding from the After Effects panel.
FEEDBACK_CHAT_ID=
PANEL_VERSION=1.1.1
PANEL_NOTES=
